<script>
var KP_API = '/plugins/komodo-periphery/api.php';
function kpCsrf() { return (typeof csrf_token !== 'undefined') ? csrf_token : ''; }

function kpCall(data, btn) {
    var orig = btn ? btn.value : null;
    if (btn) { btn.disabled = true; btn.value = 'Working\u2026'; }
    var payload = Object.assign({}, data, {csrf_token: kpCsrf()});
    fetch(KP_API, {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:new URLSearchParams(payload)})
    .then(function(r){return r.json();})
    .then(function(j){
        if (btn){btn.disabled=false;btn.value=orig;}
        kpFlash(j.ok, j.msg||'');
        if (j.ok) setTimeout(function(){location.reload();},700);
    })
    .catch(function(e){if(btn){btn.disabled=false;btn.value=orig;}kpFlash(false,'Request failed: '+e);});
}

function kpFlash(ok, msg) {
    var el = document.getElementById('kp-flash');
    if (!el) {
        el = document.createElement('div'); el.id='kp-flash';
        var first = document.querySelector('.kp-section');
        if (first) first.parentNode.insertBefore(el,first);
        else document.body.insertBefore(el,document.body.firstChild);
    }
    el.className='notice '+(ok?'notice-green':'notice-red');
    el.innerHTML='<pre style="margin:0;white-space:pre-wrap">'+String(msg).replace(/</g,'&lt;')+'</pre>';
    el.scrollIntoView({behavior:'smooth'});
}

function kpInstall(tagInputId, btn) {
    var tag = document.getElementById(tagInputId).value.trim();
    if (!tag){kpFlash(false,'Enter a version tag.');return;}
    kpCall({action:'install',tag:tag,csrf_token:kpCsrf()}, btn);
}

function kpLoadReleases(btn) {
    var orig=btn.value; btn.disabled=true; btn.value='Loading\u2026';
    fetch(KP_API+'?action=releases')
    .then(function(r){return r.json();})
    .then(function(j){
        btn.disabled=false; btn.value=orig;
        if (!j.ok||!j.tags||!j.tags.length){kpFlash(false,j.msg||'Could not fetch releases.');return;}
        var tbody=document.getElementById('kp-rel-body');
        tbody.innerHTML=j.tags.map(function(t,i){
            return '<tr><td>'+t+(i===0?' <em>(latest)</em>':'')+
                   '</td><td><input type="button" value="Install" onclick="document.getElementById(\'kp-tag\').value=\''+t+'\';kpInstall(\'kp-tag\',this)"></td></tr>';
        }).join('');
        document.getElementById('kp-rel-list').style.display='';
    })
    .catch(function(e){btn.disabled=false;btn.value=orig;kpFlash(false,'Failed: '+e);});
}

function kpCheckUpdates(btn) {
    var orig=btn.value; btn.disabled=true; btn.value='Loading\u2026';
    fetch(KP_API+'?action=releases')
    .then(function(r){return r.json();})
    .then(function(j){
        btn.disabled=false; btn.value=orig;
        if (!j.ok||!j.tags||!j.tags.length){kpFlash(false,j.msg||'Could not fetch releases.');return;}
        var inst=document.getElementById('kp-inst-ver').textContent.trim();
        var sel=document.getElementById('kp-ver-sel');
        sel.innerHTML=j.tags.map(function(t,i){
            return '<option value="'+t+'"'+(t===inst?' selected':'')+'>'+t+(i===0?' (latest)':'')+' </option>';
        }).join('');
        document.getElementById('kp-ver-row').style.display='';
        if(j.tags[0]!==inst) kpFlash(false,'Update available: '+j.tags[0]+' \u2014 installed: '+inst);
        else kpFlash(true,'Up to date ('+inst+')');
    })
    .catch(function(e){btn.disabled=false;btn.value=orig;kpFlash(false,'Failed: '+e);});
}

// Toggle a config row enabled/disabled when checkbox changes
function kpToggleRow(cb, rowId) {
    var row = document.getElementById(rowId);
    if (!row) return;
    if (cb.checked) { row.classList.remove('kp-disabled'); row.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=false;}); }
    else            { row.classList.add('kp-disabled');    row.querySelectorAll('input,select,textarea').forEach(function(el){el.disabled=true;}); }
}

// Serialise the config form to TOML and submit
function kpSaveConfig() {
    var lines = [];
    // Collect all enabled fields
    document.querySelectorAll('.kp-field[data-key]').forEach(function(el) {
        if (el.disabled) return; // unchecked/disabled
        var key = el.getAttribute('data-key');
        var type = el.getAttribute('data-type') || 'string';
        var val = el.value.trim();
        if (type === 'bool') {
            lines.push(key + ' = ' + (el.value === 'true' ? 'true' : 'false'));
        } else if (type === 'int') {
            if (val !== '') lines.push(key + ' = ' + parseInt(val, 10));
        } else if (type === 'array') {
            // Comma-separated list -> TOML array of quoted strings
            if (val === '') { lines.push(key + ' = []'); }
            else {
                var parts = val.split(',').map(function(s){return '"'+s.trim().replace(/"/g,'\\"')+'"';}).filter(Boolean);
                lines.push(key + ' = [' + parts.join(', ') + ']');
            }
        } else {
            // string
            lines.push(key + ' = "' + val.replace(/\\/g,'\\\\').replace(/"/g,'\\"') + '"');
        }
    });
    // Append raw tail sections (git_provider, docker_registry, secrets etc.)
    var tail = document.getElementById('kp-tail').value.trim();
    if (tail) lines.push('', tail);
    kpCall({action:'save', config: lines.join("\n")}, document.getElementById('kp-save-btn'));
}
</script>

