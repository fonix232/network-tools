// Convert ANSI escape codes to HTML. Text portions are HTML-escaped.
function kp_ansi2html(string $text): string {
    static $fg = [
        '30' => '#555', '31' => '#e06c75', '32' => '#98c379',
        '33' => '#e5c07b', '34' => '#61afef', '35' => '#c678dd',
        '36' => '#56b6c2', '37' => '#abb2bf', '39' => null,
        '90' => '#666', '91' => '#ff7b7b', '92' => '#b5e890',
        '93' => '#ffe08a', '94' => '#9ac8ff', '95' => '#e0a0ff',
        '96' => '#80d9e9', '97' => '#fff',
    ];
    $out   = '';
    $depth = 0;
    // Split on ESC[ sequences; PREG_SPLIT_DELIM_CAPTURE gives alternating text/code
    $parts = preg_split('/\x1b\[([0-9;]*)m/', $text, -1, PREG_SPLIT_DELIM_CAPTURE);
    // Also strip remaining non-colour ESC sequences (OSC, cursor, etc.)
    $strip = static function(string $s): string {
        return preg_replace('/\x1b[^\x1b]*?[A-Za-z]/', '', $s);
    };
    for ($i = 0, $n = count($parts); $i < $n; $i++) {
        if ($i % 2 === 0) {
            $out .= htmlspecialchars($strip($parts[$i]), ENT_QUOTES, 'UTF-8');
        } else {
            foreach (explode(';', $parts[$i] !== '' ? $parts[$i] : '0') as $code) {
                $code = ltrim($code, '0') ?: '0';
                if ($code === '0' || $code === '') {
                    $out  .= str_repeat('</span>', $depth);
                    $depth = 0;
                } elseif ($code === '1') {
                    $out .= '<span style="font-weight:bold">'; $depth++;
                } elseif ($code === '2') {
                    $out .= '<span style="opacity:0.5">'; $depth++;
                } elseif ($code === '3') {
                    $out .= '<span style="font-style:italic">'; $depth++;
                } elseif (isset($fg[$code])) {
                    if ($fg[$code] !== null) { $out .= '<span style="color:' . $fg[$code] . '">'; $depth++; }
                }
            }
        }
    }
    return $out . str_repeat('</span>', $depth);
}

$kp_log_lines = '';
if (file_exists($kp_LOGFILE)) {
    $kp_log_lines = kp_ansi2html(implode('', array_slice(file($kp_LOGFILE), -80)));
