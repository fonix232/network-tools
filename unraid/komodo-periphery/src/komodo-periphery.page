// Helper macros for rendering rows
// Each field: [key, type, label, default, description, options(for select)]
// Types: string | int | bool | array | password | path | select

function kp_row(array $cv, string $key, string $type, string $label, string $default_val, string $desc, array $opts = []): void {
    $enabled  = kp_enabled($cv, $key);
    $raw_val  = kp_val($cv, $key, $default_val);
    $row_id   = 'kp-row-' . str_replace(['.','_'], '-', $key);
    $field_id = 'kp-f-' . str_replace(['.','_'], '-', $key);
    $disabled = $enabled ? '' : 'disabled';
    $checked  = $enabled ? 'checked' : '';
    $row_cls  = $enabled ? 'kp-row' : 'kp-row kp-disabled';

    // Decode value
    if ($type === 'bool') {
        $display_val = kp_bool($cv, $key, strtolower($default_val) === 'true') ? 'true' : 'false';
    } elseif ($type === 'array') {
        $display_val = $enabled ? kp_unarray($raw_val) : kp_unarray($default_val);
    } else {
        $display_val = $enabled ? kp_unquote($raw_val) : kp_unquote($default_val);
    }

    echo '<div id="' . kp_h($row_id) . '" class="' . kp_h($row_cls) . '">';
    echo '<label>';
    echo '<input type="checkbox" ' . $checked . ' onchange="kpToggleRow(this,\'' . kp_h($row_id) . '\')">';
    echo '&nbsp;' . kp_h($label);
    echo '</label>';
    echo '<div>';
    if ($desc) echo '<div class="kp-desc">' . kp_h($desc) . '</div>';

    if ($type === 'bool') {
        echo '<select id="' . kp_h($field_id) . '" class="kp-field" data-key="' . kp_h($key) . '" data-type="bool" ' . $disabled . '>';
        echo '<option value="true"'  . ($display_val === 'true'  ? ' selected' : '') . '>true</option>';
        echo '<option value="false"' . ($display_val === 'false' ? ' selected' : '') . '>false</option>';
        echo '</select>';
    } elseif ($type === 'select') {
        echo '<select id="' . kp_h($field_id) . '" class="kp-field" data-key="' . kp_h($key) . '" data-type="select" ' . $disabled . '>';
        foreach ($opts as $o) {
            echo '<option value="' . kp_h($o) . '"' . ($display_val === $o ? ' selected' : '') . '>' . kp_h($o) . '</option>';
        }
        echo '</select>';
    } elseif ($type === 'array') {
        echo '<input type="text" id="' . kp_h($field_id) . '" class="kp-field" data-key="' . kp_h($key) . '" data-type="array" value="' . kp_h($display_val) . '" placeholder="comma-separated, e.g. /mnt/user, /mnt/cache" ' . $disabled . '>';
    } elseif ($type === 'int') {
        echo '<input type="number" id="' . kp_h($field_id) . '" class="kp-field" data-key="' . kp_h($key) . '" data-type="int" value="' . kp_h($display_val) . '" style="width:8em" ' . $disabled . '>';
    } else {
        // string / path / password
        $itype = ($type === 'password') ? 'password' : 'text';
        echo '<input type="' . $itype . '" id="' . kp_h($field_id) . '" class="kp-field" data-key="' . kp_h($key) . '" data-type="string" value="' . kp_h($display_val) . '" ' . $disabled . '>';
    }

    echo '</div></div>';
}
