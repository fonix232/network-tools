function kp_h(string $s): string {
    return htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
}
function kp_svc_running(string $pidfile): array {
    if (!file_exists($pidfile)) return ['running' => false, 'pid' => null];
    $pid = (int) trim(file_get_contents($pidfile));
    $running = $pid > 0 && file_exists("/proc/$pid");
    return ['running' => $running, 'pid' => $running ? $pid : null];
}
function kp_mnt_shares(): array {
    $shares = [];
    if (!file_exists('/proc/mounts')) return $shares;
    foreach (file('/proc/mounts') as $line) {
        $mp = preg_split('/\s+/', trim($line))[1] ?? '';
        if (preg_match('#^/mnt/[^/]+$#', $mp)) $shares[] = $mp;
    }
    sort($shares);
    return array_unique($shares);
}
function kp_read_cfg(string $live, string $flash): string {
    if (file_exists($live))  return file_get_contents($live);
    if (file_exists($flash)) return file_get_contents($flash);
    return '';
}
function kp_is_paired(string $cfg): bool {
    foreach (explode("\n", $cfg) as $l) {
        $l = trim($l);
        if ($l === '' || $l[0] === '#') continue;
        if (preg_match('/^\s*(core_address|core_public_keys)\s*=\s*"(.+)"/', $l, $m) && $m[2] !== '')
            return true;
    }
    return false;
}

// Parse scalar (non-table) key=value pairs from TOML, ignoring comments and tables
function kp_parse_toml(string $raw): array {
    $vals = [];
    $in_table = false;
    foreach (explode("\n", $raw) as $line) {
        $l = trim($line);
        if ($l === '' || $l[0] === '#') continue;
        // Detect start of table/array-of-tables section
        if ($l[0] === '[') { $in_table = true; continue; }
        if ($in_table) continue;
        if (preg_match('/^([a-zA-Z0-9_.]+)\s*=\s*(.+)/', $l, $m)) {
            $vals[trim($m[1])] = trim($m[2]);
        }
    }
    return $vals;
}

// Extract raw tail sections (git_provider, docker_registry, secrets, passkeys table etc.)
function kp_tail_sections(string $raw): string {
    $lines  = explode("\n", $raw);
    $result = [];
    $in_tail = false;
    foreach ($lines as $line) {
        $l = trim($line);
        if (!$in_tail && $l !== '' && $l[0] === '[') {
            $in_tail = true;
        }
        if ($in_tail) $result[] = $line;
    }
    return implode("\n", $result);
}

