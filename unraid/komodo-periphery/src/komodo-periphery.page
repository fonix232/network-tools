<script>
// Patch kpSaveConfig to support Save only (no restart)
(function(){
    var origSave = kpSaveConfig;
    kpSaveConfig = function() {
        var lines = [];
        document.querySelectorAll('.kp-field[data-key]').forEach(function(el) {
            if (el.disabled) return;
            var key = el.getAttribute('data-key');
            var type = el.getAttribute('data-type') || 'string';
            var val = el.value.trim();
            if (type === 'bool') {
                lines.push(key + ' = ' + (el.value === 'true' ? 'true' : 'false'));
            } else if (type === 'int') {
                if (val !== '') lines.push(key + ' = ' + parseInt(val, 10));
            } else if (type === 'array') {
                if (val === '') { lines.push(key + ' = []'); }
                else {
                    var parts = val.split(',').map(function(s){return '"'+s.trim().replace(/"/g,'\\"')+'"';}).filter(Boolean);
                    lines.push(key + ' = [' + parts.join(', ') + ']');
                }
            } else {
                lines.push(key + ' = "' + val.replace(/\\/g,'\\\\').replace(/"/g,'\\"') + '"');
            }
        });
        var tail = document.getElementById('kp-tail').value.trim();
        if (tail) lines.push('', tail);
        var btn = document.getElementById('kp-save-btn');
        var noRestart = btn.getAttribute('data-no-restart') === '1';
        btn.removeAttribute('data-no-restart');
        var saveBtn = noRestart ? document.querySelector('input[value="Save only"]') : btn;
        kpCall({action: noRestart ? 'save' : 'save_restart', config: lines.join("\n")}, saveBtn);
    };
})();
</script>

