// Helper: get current value or default, and whether it's explicitly enabled (uncommented)
function kp_val(array $cv, string $key, string $default): string {
    return isset($cv[$key]) ? $cv[$key] : $default;
}
function kp_enabled(array $cv, string $key): bool {
    return isset($cv[$key]);
}
// Strip surrounding quotes from a TOML string value
function kp_unquote(string $v): string {
    if (strlen($v) >= 2 && $v[0] === '"' && $v[-1] === '"') return substr($v, 1, -1);
    return $v;
}
// Strip TOML array brackets and return comma-separated values
function kp_unarray(string $v): string {
    $v = trim($v);
    if ($v === '[]') return '';
    $v = preg_replace('/^\[|\]$/', '', $v);
    // Remove quotes from each element
    $parts = preg_split('/\s*,\s*/', trim($v));
    return implode(', ', array_map(function($p) { return trim($p, ' "\''); }, array_filter($parts, 'strlen')));
}
// Bool value from TOML
function kp_bool(array $cv, string $key, bool $default): bool {
    if (!isset($cv[$key])) return $default;
    return strtolower(trim($cv[$key])) === 'true';
}
