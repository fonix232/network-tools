  </div>

  <hr style="border-color:#444; margin:16px 0">
  <p><strong>Generate new key</strong></p>
  <table style="border:none;border-collapse:collapse;margin-bottom:8px">
    <tr>
      <td style="padding:4px 8px 4px 0">Name</td>
      <td><input type="text" id="gp-gen-name" style="width:16em" placeholder="e.g. <?= gp_h(strtolower(gethostname())) ?>"></td>
      <td style="padding:4px 8px">Email</td>
      <td><input type="text" id="gp-gen-email" style="width:18em" placeholder="e.g. <?= gp_h(strtolower(gethostname())) ?>@example.com (optional)"></td>
    </tr>
    <tr>
      <td style="padding:4px 8px 4px 0">Algorithm</td>
      <td>
        <select id="gp-gen-algo">
          <option value="ed25519" selected>ed25519 (recommended)</option>
          <option value="rsa4096">RSA 4096</option>
          <option value="rsa2048">RSA 2048</option>
          <option value="nistp256">NIST P-256</option>
          <option value="nistp384">NIST P-384</option>
          <option value="nistp521">NIST P-521</option>
        </select>
      </td>
      <td style="padding:4px 8px">Capabilities</td>
      <td>
        <label style="margin-right:10px"><input type="checkbox" checked disabled> cert (always)</label>
        <label style="margin-right:10px"><input type="checkbox" id="gp-gen-sign" checked> sign</label>
        <label style="margin-right:10px"><input type="checkbox" id="gp-gen-auth"> auth</label>
        <label><input type="checkbox" id="gp-gen-encr" checked> add encryption subkey</label>
      </td>
    </tr>
  </table>
  <input type="button" value="Generate" onclick="gpGenerateKey(this)">
  <p style="font-size:0.85em;margin-top:6px">No passphrase, no expiry. The encryption subkey algorithm is automatically paired with the primary key algorithm.</p>
</div>

<!-- ======================= BACKUP ======================= -->
<div class="title gp-section"><span class="left">Keyring Backup</span></div>
<div class="pluginUpdate" style="margin-bottom:20px">
  <p>
    Flash backup: <?= $gp_legacy_ok
        ? '<span class="gp-badge gp-badge-ok">present</span> at <code>' . gp_h($gp_flash_dir) . '/</code>'
        : '<span class="gp-badge gp-badge-warn">not found</span>' ?>
    &nbsp;Snapshots: <?= $gp_snap_count > 0
        ? '<span class="gp-badge gp-badge-ok">' . (int) $gp_snap_count . '</span> in <code>' . gp_h($gp_snap_dir) . '/</code>'
        : '<span class="gp-badge gp-badge-warn">none yet</span>' ?>
  </p>
  <p style="font-size:0.85em">
    The keyring is mirrored to flash on array stop and restored on array start,
    as before. Every write to the flash backup now takes a snapshot of it first,
    so the previous contents survive even if the mirror overwrites itself with an
    empty keyring. Snapshots are also taken daily at 04:40 and whenever a key is
    added or removed. Identical snapshots are skipped, and the most recent
    <?= (int) 10 ?> are kept.
  </p>
  <p style="font-size:0.85em;color:#c99">
    Secret keys are stored unencrypted on the flash drive. Anyone with the flash
    device, or a copy of a flash backup <code>.zip</code>, has your private keys.
  </p>
  <table class="gp-table" id="gp-snap-table" style="display:none">
    <thead>
      <tr><th>Snapshot</th><th>Taken</th><th>Secret keys</th><th>Reason</th><th>Size</th><th></th></tr>
    </thead>
    <tbody id="gp-snap-body"></tbody>
  </table>
  <div id="gp-snap-empty" style="color:#888;display:none">No snapshots on flash yet.</div>
  <div class="gp-actions">
    <input type="button" value="Backup now" onclick="gpCall({action:'backup'},this)">
    <input type="button" value="Restore from flash" onclick="if(confirm('Restore the keyring from the flash backup? The current keyring is stashed under /root first.'))gpCall({action:'restore'},this)">
  </div>
</div>

<script>
// Load keys on page load
(function() {
    fetch(GP_API + '?action=status')
    .then(function(r) { return r.json(); })
    .then(function(j) {
        document.getElementById('gp-keys-loading').style.display = 'none';
        if (!j.ok) return;
        gpRenderSnapshots(j.snapshots);
        if (!j.keys) return;
        var tbody = document.getElementById('gp-keys-body');
        document.getElementById('gp-keys-table').style.display = '';
        if (j.keys.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" style="color:#888">No keys found.</td></tr>';
            return;
        }
        j.keys.forEach(function(k) {
            var fprShort = k.fpr.substring(k.fpr.length - 16);
            var created = k.created ? new Date(parseInt(k.created) * 1000).toISOString().split('T')[0] : '';
            var type = k.secret
                ? '<span class="gp-badge gp-badge-ok">sec+pub</span>'
                : '<span class="gp-badge gp-badge-none">pub</span>';
            var row = '<tr>' +
                '<td>' + (k.uid || '').replace(/</g, '&lt;') + '</td>' +
                '<td class="gp-key-fpr" title="' + k.fpr + '">' + fprShort + '</td>' +
                '<td>' + gpAlgoName(k.algo, k.bits) + '</td>' +
                '<td>' + gpCapsBadges(k.caps) + '</td>' +
                '<td>' + created + '</td>' +
                '<td>' + type + '</td>' +
                '<td>' +
                    '<input type="button" value="Export" onclick="gpExportKey(\'' + k.fpr + '\')" style="margin-right:4px">' +
                    '<input type="button" value="Delete" onclick="gpDeleteKey(\'' + k.fpr + '\',this)">' +
                '</td>' +
                '</tr>';
            tbody.innerHTML += row;
        });
    })
    .catch(function(e) {
        document.getElementById('gp-keys-loading').textContent = 'Failed to load keys: ' + e;
    });
})();
</script>
