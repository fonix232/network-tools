# Python
__pycache__/
*.pyc

# Generated build artifacts
*.plg
**/output/*.run
unraid/docker-model/dist/

# ...except the published copies CI commits back to main. These are what
# Unraid's plugin update checker fetches via each plugin's pluginURL, so they
# must be tracked and must always reflect the newest release.
!plugins/*.plg

# OS
.DS_Store
