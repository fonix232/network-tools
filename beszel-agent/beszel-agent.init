#!/bin/sh /etc/rc.common
# Beszel agent (network-tools/beszel-agent). Settings live in $ENV_FILE, one
# KEY=value per line, passed to the agent verbatim.

USE_PROCD=1
START=99
STOP=10

ENV_FILE=/etc/beszel-agent/env

start_service() {
	[ -r "$ENV_FILE" ] || { echo "beszel-agent: $ENV_FILE missing" >&2; return 1; }

	set --
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in '' | \#*) continue ;; esac
		set -- "$@" "$line"
	done <"$ENV_FILE"

	procd_open_instance
	procd_set_param command /usr/bin/beszel-agent
	procd_set_param user beszel
	procd_set_param env "$@"
	# Retry forever: the agent only exits on fatal errors, and a hub outage
	# shouldn't leave it dead until the next reboot.
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
