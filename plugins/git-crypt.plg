<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name       "git-crypt">
  <!ENTITY version    "2026.08.01">
  <!ENTITY plugin_dir "/boot/config/plugins/git-crypt">
]>
<PLUGIN name="&name;"
        version="&version;"
        pluginURL="https://raw.githubusercontent.com/fonix232/network-tools/main/plugins/git-crypt.plg"
        support="https://github.com/fonix232/network-tools/issues"
        min="6.10.0">

<CHANGES>
### 2026.08.01
- Downloads latest git-crypt linux-x86_64 binary from GitHub releases on install
- Restores cached binary from flash on every array start
- Web UI for install/update/version checks
</CHANGES>

<FILE Name="/usr/local/emhttp/plugins/git-crypt/event/started" Mode="0755">
<INLINE>
<![CDATA[
#!/bin/bash
PLUGIN_DIR="/boot/config/plugins/git-crypt"
CACHED="$PLUGIN_DIR/git-crypt"
INSTALL_PATH="/usr/local/bin/git-crypt"

if [ -f "$CACHED" ]; then
    install -m 0755 "$CACHED" "$INSTALL_PATH"
    echo "git-crypt: installed from flash to $INSTALL_PATH"
else
    echo "git-crypt: cached binary not found at $CACHED — reinstall the plugin to download it"
fi
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/git-crypt/git-crypt.page" Mode="0644">
<INLINE>
<![CDATA[
Menu="Utilities"
Title="git-crypt"
Icon="lock"
Tag="key"
---
<?php
/*
 * git-crypt -- UnRaid management page
 * IMPORTANT: PHP-included inside emhttp. No header(), exit(), die().
 * No remote HTTP from PHP. All mutations via api.php fetch().
 */

$gc_PLUGIN_DIR   = '/boot/config/plugins/git-crypt';
$gc_CACHED       = "$gc_PLUGIN_DIR/git-crypt";

function gc_h(string $s): string {
    return htmlspecialchars($s, ENT_QUOTES, 'UTF-8');
}

// Detect git-crypt by running it; no reliance on cached file or version file
exec('git-crypt --version 2>&1', $gc_ver_out, $gc_rc);
$gc_bin_ver   = $gc_rc === 0 ? trim(implode(' ', $gc_ver_out)) : '';
$gc_binary_ok = $gc_bin_ver !== '';
?>

<style>
.gc-section { margin-bottom: 20px; }
</style>

<script>
var GC_API = '/plugins/git-crypt/api.php';
function gcCsrf() { return (typeof csrf_token !== 'undefined') ? csrf_token : ''; }

function gcFlash(ok, msg) {
    var el = document.getElementById('gc-flash');
    if (!el) {
        el = document.createElement('div'); el.id = 'gc-flash';
        var first = document.querySelector('.title');
        if (first) first.parentNode.insertBefore(el, first);
        else document.body.insertBefore(el, document.body.firstChild);
    }
    el.className = 'notice ' + (ok ? 'notice-green' : 'notice-red');
    el.innerHTML = '<pre style="margin:0;white-space:pre-wrap">' + String(msg).replace(/</g, '&lt;') + '</pre>';
    el.scrollIntoView({behavior: 'smooth'});
}

function gcCall(data, btn) {
    var orig = btn ? btn.value : null;
    if (btn) { btn.disabled = true; btn.value = 'Working\u2026'; }
    var payload = Object.assign({}, data, {csrf_token: gcCsrf()});
    fetch(GC_API, {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: new URLSearchParams(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(j) {
        if (btn) { btn.disabled = false; btn.value = orig; }
        gcFlash(j.ok, j.msg || '');
        if (j.ok) setTimeout(function() { location.reload(); }, 800);
    })
    .catch(function(e) {
        if (btn) { btn.disabled = false; btn.value = orig; }
        gcFlash(false, 'Request failed: ' + e);
    });
}

function gcCheckUpdates(btn) {
    var orig = btn.value; btn.disabled = true; btn.value = 'Loading\u2026';
    fetch(GC_API + '?action=releases')
    .then(function(r) { return r.json(); })
    .then(function(j) {
        btn.disabled = false; btn.value = orig;
        if (!j.ok || !j.tags || !j.tags.length) {
            gcFlash(false, j.msg || 'Could not fetch releases.');
            return;
        }
        var inst = document.getElementById('gc-inst-ver').textContent.trim();
        var sel  = document.getElementById('gc-ver-sel');
        sel.innerHTML = j.tags.map(function(t, i) {
            return '<option value="' + t + '"' + (t === inst ? ' selected' : '') + '>' +
                   t + (i === 0 ? ' (latest)' : '') + '</option>';
        }).join('');
        document.getElementById('gc-ver-row').style.display = '';
        if (j.tags[0] !== inst) gcFlash(false, 'Update available: ' + j.tags[0] + ' \u2014 installed: ' + (inst || 'none'));
        else gcFlash(true, 'Up to date (' + inst + ')');
    })
    .catch(function(e) { btn.disabled = false; btn.value = orig; gcFlash(false, 'Failed: ' + e); });
}
</script>

<!-- ======================= STATUS ======================= -->
<div class="title gc-section"><span class="left">git-crypt</span></div>
<div class="pluginUpdate" style="margin-bottom:20px">
<?php if ($gc_binary_ok): ?>
  <p>
    Installed version: <strong id="gc-inst-ver"><?= gc_h($gc_bin_ver) ?></strong>
  </p>
  <p>
    <input type="button" value="Check for updates" onclick="gcCheckUpdates(this)">
  </p>
  <p id="gc-ver-row" style="display:none">
    Switch to:&nbsp;<select id="gc-ver-sel"></select>
    &nbsp;<input type="button" value="Install selected"
        onclick="gcCall({action:'install',tag:document.getElementById('gc-ver-sel').value},this)">
  </p>
<?php else: ?>
  <p>The git-crypt binary has not been downloaded yet.</p>
  <p>
    <input type="button" value="Install latest"
        onclick="gcCall({action:'install',tag:'__latest__'},this)">
  </p>
  <p style="font-size:0.85em">
    Or specify a tag:&nbsp;
    <input type="text" id="gc-tag" style="width:10em" placeholder="e.g. 0.8.0">
    &nbsp;<input type="button" value="Install" onclick="gcCall({action:'install',tag:document.getElementById('gc-tag').value.trim()},this)">
  </p>
  <p style="font-size:0.85em">
    Releases: <a href="https://github.com/AGWA/git-crypt/releases" target="_blank">github.com/AGWA/git-crypt/releases</a>
  </p>
<?php endif; ?>
</div>
]]>
</INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/git-crypt/api.php" Mode="0644">
<INLINE>
<![CDATA[
<?php
/*
 * git-crypt -- API endpoint
 * Installed to: /usr/local/emhttp/plugins/git-crypt/api.php
 *
 * Called via AJAX from the management page.
 * Returns JSON: { "ok": bool, "msg": string }
 */

header('Content-Type: application/json');

$PLUGIN_DIR   = '/boot/config/plugins/git-crypt';
$CACHED       = "$PLUGIN_DIR/git-crypt";
$INSTALL_PATH = '/usr/local/bin/git-crypt';
$VER_FILE     = "$PLUGIN_DIR/version";
$GITHUB_REPO  = 'AGWA/git-crypt';

function api_json(bool $ok, string $msg): void {
    echo json_encode(['ok' => $ok, 'msg' => $msg]);
    if (ob_get_level()) ob_end_flush();
    flush();
    exit;
}

$action = $_POST['action'] ?? $_GET['action'] ?? '';

switch ($action) {

    case 'install':
        $tag = preg_replace('/[^a-zA-Z0-9.\-]/', '', $_POST['tag'] ?? '');
        if ($tag === '') api_json(false, 'No version tag supplied.');

        // Resolve __latest__ sentinel to the actual latest tag
        if ($tag === '__latest__') {
            $ctx = stream_context_create(['http' => ['timeout' => 10, 'user_agent' => 'git-crypt-unraid/1.0', 'ignore_errors' => true]]);
            $latest_json = @file_get_contents("https://api.github.com/repos/$GITHUB_REPO/releases/latest", false, $ctx);
            $latest_data = json_decode($latest_json ?: '{}', true);
            $tag = preg_replace('/[^a-zA-Z0-9.\-]/', '', $latest_data['tag_name'] ?? '');
            if ($tag === '') api_json(false, 'Could not resolve latest release tag from GitHub.');
        }

        $url = "https://github.com/$GITHUB_REPO/releases/download/$tag/git-crypt-$tag-linux-x86_64";
        $tmp = "$CACHED.tmp";
        @mkdir($PLUGIN_DIR, 0755, true);

        exec('curl -fsSL ' . escapeshellarg($url) . ' -o ' . escapeshellarg($tmp) . ' 2>&1', $out, $rc);

        if ($rc !== 0 || !file_exists($tmp) || filesize($tmp) < 1024) {
            @unlink($tmp);
            api_json(false, "Download failed for $tag:\n" . implode("\n", $out));
        }

        rename($tmp, $CACHED);
        chmod($CACHED, 0755);
        file_put_contents($VER_FILE, $tag);

        // Copy into RAM
        copy($CACHED, $INSTALL_PATH);
        chmod($INSTALL_PATH, 0755);

        exec(escapeshellarg($INSTALL_PATH) . ' --version 2>&1', $ver_out);
        api_json(true, "Installed git-crypt $tag.\n" . implode("\n", $ver_out));

    case 'releases':
        $ctx = stream_context_create(['http' => [
            'timeout'       => 10,
            'user_agent'    => 'git-crypt-unraid/1.0',
            'ignore_errors' => true,
        ]]);
        $json = @file_get_contents(
            "https://api.github.com/repos/$GITHUB_REPO/releases?per_page=10",
            false, $ctx
        );
        $data = json_decode($json ?: '[]', true);
        $tags = [];
        if (is_array($data)) {
            foreach ($data as $r) {
                if (!($r['prerelease'] ?? true) && isset($r['tag_name'])) $tags[] = $r['tag_name'];
            }
        }
        if (empty($tags)) api_json(false, 'Could not fetch releases from GitHub.');
        echo json_encode(['ok' => true, 'tags' => $tags]);
        exit;

    default:
        api_json(false, "Unknown action: $action");
}
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
set -e

PLUGIN_DIR="/boot/config/plugins/git-crypt"
CACHED="$PLUGIN_DIR/git-crypt"
INSTALL_PATH="/usr/local/bin/git-crypt"
GITHUB_REPO="AGWA/git-crypt"

mkdir -p "$PLUGIN_DIR"
mkdir -p "/usr/local/emhttp/plugins/git-crypt/event"

echo "git-crypt: querying GitHub for latest release..."
TAG=$(curl -sf "https://api.github.com/repos/${GITHUB_REPO}/releases/latest" \
    | python3 -c "import json,sys; print(json.load(sys.stdin)['tag_name'])") || {
    echo "git-crypt: ERROR — failed to query GitHub API"
    exit 1
}

URL="https://github.com/${GITHUB_REPO}/releases/download/${TAG}/git-crypt-${TAG}-linux-x86_64"
echo "git-crypt: downloading $URL"
curl -fsSL --retry 3 "$URL" -o "$CACHED" || {
    echo "git-crypt: ERROR — download failed"
    exit 1
}
chmod 0755 "$CACHED"
echo "$TAG" > "$PLUGIN_DIR/version"

install -m 0755 "$CACHED" "$INSTALL_PATH"
echo "git-crypt: installed ${TAG} to $INSTALL_PATH"
git-crypt --version 2>&1 || true
]]>
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash
rm -f /usr/local/bin/git-crypt
rm -rf /usr/local/emhttp/plugins/git-crypt

echo "git-crypt plugin removed."
echo "Cached binary preserved at /boot/config/plugins/git-crypt/ — remove manually if no longer needed."
]]>
</INLINE>
</FILE>

</PLUGIN>
