<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "komodo-periphery">
  <!ENTITY version     "2026.10.02">
  <!ENTITY plugin_dir  "/boot/config/plugins/komodo-periphery">
]>
<PLUGIN name="&name;"
        version="&version;"
        pluginURL="https://raw.githubusercontent.com/fonix232/network-tools/main/plugins/komodo-periphery.plg"
        support="https://github.com/fonix232/network-tools/issues"
        min="6.10.0">

<CHANGES>
### 2026.10.02
- Built by GHA from tools/unraid/komodo-periphery/src/
- Native UnRaid daemon (no Docker required)
- Noise private/public key authentication
- Version selection and updates via the web UI
</CHANGES>

<!-- Runtime package: rc script, web UI, event hooks (embedded txz) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
TXZ=/tmp/komodo-periphery-2026.10.02-x86_64-1.txz
base64 -d <<'__TXZ_EOF__' > "$TXZ"

__TXZ_EOF__
removepkg komodo-periphery 2>/dev/null || true
installpkg "$TXZ"
rm -f "$TXZ"
]]>
</INLINE>
</FILE>

<!-- Default config — seeded to /etc/komodo/ on first run, restored from flash on every boot -->
<FILE Name="&plugin_dir;/periphery.config.toml" Mode="0644">
<INLINE>
<![CDATA[
## Komodo Periphery — UnRaid
## Full reference: https://github.com/moghtech/komodo/blob/main/config/periphery.config.toml
##
## Edit this file via the UnRaid web UI (Plugins -> Komodo Periphery) or directly
## at /boot/config/komodo-periphery/periphery.config.toml on flash.
## Changes take effect after restarting the service.

###########
# GENERAL #
###########

root_directory = "/etc/komodo"

########
# AUTH #
########

## Noise private key — auto-generated on first start if the file does not exist.
private_key = "file:/etc/komodo/keys/periphery.key"

## Add the Komodo Core public key here after the first connection attempt.
## Find it in Core -> Settings -> Keys, or in the Core startup logs.
# core_public_keys = "MCow..."

################
# INBOUND MODE #
################

port = 8120
bind_ip = "[::]"

## Restrict inbound connections to Komodo Core only (recommended).
## Supports exact IPs and CIDR subnets.
## When Core runs in a container on THIS host, its connections arrive from the
## Docker bridge subnets (no NAT for host-local traffic) — allow 172.16.0.0/12
## plus loopback. Cores on other hosts appear as their LAN IP.
allowed_ips = ["127.0.0.1", "::1", "172.16.0.0/12"]

ssl_enabled = true

###########
# LOGGING #
###########

logging.level = "info"
logging.stdio = "standard"

##########
# DISKS  #
##########

## Only report these mount points in the disk view.
include_disk_mounts = ["/mnt/user", "/boot"]
]]>
</INLINE>
</FILE>

<!-- Install / upgrade -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
#!/bin/bash
set -e

PLUGIN_DIR="/boot/config/plugins/komodo-periphery"

mkdir -p "$PLUGIN_DIR"

# Remove any legacy /boot/config/go entry from previous installs
if [ -f /boot/config/go ]; then
    sed -i '\|komodo-periphery/rc.komodo-periphery|d' /boot/config/go
fi

echo ""
echo "komodo-periphery plugin installed."
echo "Visit Utilities -> Komodo Periphery to download the binary and configure."
]]>
</INLINE>
</FILE>

<!-- Uninstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
#!/bin/bash

PLUGIN_DIR="/boot/config/plugins/komodo-periphery"

sh "$PLUGIN_DIR/rc.komodo-periphery" stop 2>/dev/null || true

rm -f /usr/local/bin/periphery
rm -rf /usr/local/emhttp/plugins/komodo-periphery

# Remove any legacy /boot/config/go entry
if [ -f /boot/config/go ]; then
    sed -i '\|komodo-periphery/rc.komodo-periphery|d' /boot/config/go
fi

echo "komodo-periphery removed."
echo "Config and keys in $PLUGIN_DIR have been preserved — remove manually if no longer needed."
]]>
</INLINE>
</FILE>

</PLUGIN>
